{
  "name": "littlething-cat-desktop",
  "version": "1.0.3",
  "description": "小叽 3D 小猫桌面版 - Electron 封装",
  "author": {
    "name": "LittleThing Local",
    "email": "chenzhenyu@gdcattsoft.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astroschen/littlething-desktop.git"
  },
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "start": "electron .",
    "build:win": "node scripts/build.js --win",
    "build:mac": "node scripts/build.js --mac",
    "build:linux": "node scripts/build.js --linux"
  },
  "build": {
    "appId": "com.workbuddy.littlething.cat",
    "productName": "小叽",
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB",
      "ja",
      "ko",
      "fr",
      "de",
      "es",
      "es-419",
      "ru",
      "pt-BR",
      "it",
      "ar",
      "hi"
    ],
    "files": [
      "main.js",
      "input/**/*",
      "!input/*.test.js",
      "password-probe.js",
      "preload.js",
      "pet.html",
      "pet.js",
      "settings.html",
      "settings.js",
      "menu.html",
      "menu.js",
      "menu-preload.js",
      "skin-editor.html",
      "editor.js",
      "index.html",
      "app.js",
      "assets/**/*",
      "!node_modules/@mukea/**",
      "!resources/**"
    ],
    "extraResources": [
      {
        "from": "resources/hook/node_modules/koffi",
        "to": "hook/node_modules/koffi",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hook/node_modules/@koromix/koffi-win32-x64",
        "to": "hook/node_modules/@koromix/koffi-win32-x64",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/hook/node_modules/@mukea/uiohook-napi",
        "to": "hook/node_modules/@mukea/uiohook-napi",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon/app-icon.ico"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "LittleThing Local <chenzhenyu@gdcattsoft.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "icon": "build/icon/app-icon.ico",
    "artifactName": "LittleThing-${version}-${arch}.${ext}",
    "nsis": {
      "artifactName": "LittleThing-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LittleThing-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "LittleThing-${version}-x64.${ext}"
    },
    "deb": {
      "artifactName": "LittleThing-${version}-x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "@mukea/uiohook-napi": "^2.0.1"
  }
}
