*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

